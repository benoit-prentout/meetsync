{
  "manifest_version": 3,
  "name": "MeetSync",
  "version": "1.0.0",
  "description": "Auto-sync your Google Meet notes into a master Google Doc — your living knowledge base for any AI tool.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["identity", "identity.email", "storage", "alarms"],
  "host_permissions": ["https://script.google.com/*", "https://script.googleusercontent.com/*"],
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "oauth2": {
    "client_id": "445706616860-ni2amt25cs328v5n5nvgkh9mh6l5vb7k.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "https://www.googleapis.com/auth/script.projects",
      "https://www.googleapis.com/auth/script.deployments"
    ]
  }
}